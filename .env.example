# Dart Dashboard – Konfiguration
# Diese Datei in das gleiche Verzeichnis wie docker-compose.yml legen.

# IP-Adresse des Servers (LAN-IP, für externe Geräte)
# Ohne diese Angabe wird automatisch die erste nicht-lokale IPv4 erkannt.
SERVER_IP=192.168.8.111

# Datenpfad für persistente Einstellungen (SQLite, JSON)
DATA_PATH=./data

# Externe SQL-Datenbank (optional)
# DB_CLIENT=sqlite
# DB_SQLITE_FILE=./data/dashboard.db

# Admin-PIN als scrypt-Hash im Format SALT:HEX_HASH (niemals die PIN selbst eintragen)
# Erzeugen: node -e "const c=require('crypto');const p=process.argv[1];const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(p,s,32).toString('hex'))" DEINE_PIN
# ADMIN_PIN_HASH=
# ADMIN_SESSION_TTL_MS=900000
# ADMIN_AUTH_ENABLED=true
# Backup-Ziele: USB-Pfad auf dem Pi bzw. Nextcloud-WebDAV-Konfiguration
# BACKUP_USB_PATH=/media/pi/USBNAME/dart-backups
# NEXTCLOUD_WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/USER/
# NEXTCLOUD_USER=
# NEXTCLOUD_PASSWORD=
# NEXTCLOUD_BACKUP_PATH=Dart-Dashboard-Backups